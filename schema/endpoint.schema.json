{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kyou12138/free-test-llm-api/schema/endpoint.schema.json",
  "title": "FreeTestingLLMEndpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "name_zh",
    "category",
    "provider",
    "region",
    "status",
    "openai_compatible",
    "api_key_required",
    "base_url",
    "models",
    "source_docs",
    "restrictions_zh",
    "restrictions_en",
    "env",
    "last_verified"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "name_zh": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": ["project_demo", "anonymous_public", "free_token"]
    },
    "provider": { "type": "string" },
    "region": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["active", "limited", "unknown", "down"]
    },
    "openai_compatible": { "type": "boolean" },
    "api_key_required": { "type": "boolean" },
    "api_key_url": { "type": ["string", "null"] },
    "base_url": { "type": "string", "format": "uri" },
    "chat_path_hint": { "type": "string" },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "source_docs": { "type": "string", "format": "uri" },
    "source_repo": { "type": ["string", "null"] },
    "terms": { "type": ["string", "null"] },
    "restrictions_zh": { "type": "string" },
    "restrictions_en": { "type": "string" },
    "env": {
      "type": "object",
      "required": ["LLM_BASE_URL", "LLM_MODEL_NAME"],
      "properties": {
        "LLM_BASE_URL": { "type": "string" },
        "LLM_MODEL_NAME": { "type": "string" },
        "LLM_API_KEY": { "type": "string" }
      },
      "additionalProperties": true
    },
    "last_verified": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
