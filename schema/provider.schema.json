{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/local/free-llm/schema/provider.schema.json",
  "title": "FreeLLMProvider",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "name_zh",
    "type",
    "region",
    "website",
    "docs",
    "api_key_url",
    "openai_compatible",
    "credit_card_required",
    "free_tier",
    "models_sample",
    "last_verified",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "name_zh": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": ["model_vendor", "inference_platform"]
    },
    "region": { "type": "string", "minLength": 1 },
    "website": { "type": "string", "format": "uri" },
    "docs": { "type": "string", "format": "uri" },
    "api_key_url": { "type": "string", "format": "uri" },
    "openai_compatible": { "type": "boolean" },
    "base_url": {
      "type": ["string", "null"],
      "description": "OpenAI-compatible or primary API base URL template"
    },
    "credit_card_required": { "type": "boolean" },
    "phone_required": { "type": "boolean" },
    "free_tier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permanent", "notes_zh", "notes_en", "rate_limits_summary"],
      "properties": {
        "permanent": {
          "type": "boolean",
          "const": true
        },
        "notes_zh": { "type": "string" },
        "notes_en": { "type": "string" },
        "rate_limits_summary": { "type": "string" },
        "data_used_for_training": {
          "type": ["boolean", "null"],
          "description": "Whether free-tier prompts may be used for training/improvement"
        },
        "commercial_use": {
          "type": "string",
          "enum": ["yes", "no", "unknown", "restricted"]
        }
      }
    },
    "models_sample": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "last_verified": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "type": "string",
      "enum": ["active", "limited", "unknown"]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
